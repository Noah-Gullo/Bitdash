PORT=3000
# Comma-separate local and deployed frontend URLs when needed.
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
JWT_SECRET=generate-a-long-random-secret
# Project root only — do not include /rest/v1.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Optional Upstash Redis cache for leaderboard reads.
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
